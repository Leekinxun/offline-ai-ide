+        assert_ne!(
+            unsafe {
+                LookupPrivilegeValueW(
+                    std::ptr::null(),
+                    crate::to_wide("SeChangeNotifyPrivilege").as_ptr(),
+                    &mut change_notify,
+                )
+            },
+            0
+        );
+        for entry in entries
+            .iter()
+            .filter(|entry| entry.Attributes & SE_PRIVILEGE_ENABLED != 0)
+        {
+            assert!(
+                entry.Luid.LowPart == change_notify.LowPart
+                    && entry.Luid.HighPart == change_notify.HighPart,
+                "a privilege other than SeChangeNotify is enabled in the child"
+            );
+        }
+        super::verify_wfp_filters_for_account(crate::setup::OFFLINE_USERNAME)
+            .expect("production policy probe from fresh engine in a non-impersonated non-admin owner process");
+    }
 }
