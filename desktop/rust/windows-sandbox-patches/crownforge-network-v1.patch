+        let result = unsafe { FwpmFilterGetByKey0(engine.handle, &spec.key, &mut filter) };
+        ensure_success(result, &format!("read CrownForge WFP filter {}", spec.name))?;
+        anyhow::ensure!(!filter.is_null(), "WFP returned an empty filter");
+        let matches = unsafe { filter_matches(&*filter, spec, &user) };
+        let mut memory = filter.cast();
+        unsafe { FwpmFreeMemory0(&mut memory) };
