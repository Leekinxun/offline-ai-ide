+
+unsafe fn filter_matches(
+    filter: &FWPM_FILTER0,
+    spec: &FilterSpec,
+    user: &UserMatchCondition,
+) -> bool {
+    if filter.flags & FWPM_FILTER_FLAG_PERSISTENT == 0
+        || filter.flags & FWPM_FILTER_FLAG_DISABLED != 0
+        || filter.action.r#type != FWP_ACTION_BLOCK
+        || !same_guid(&filter.layerKey, &spec.layer_key)
+        || !same_guid(&filter.subLayerKey, &SUBLAYER_KEY)
+        || filter.providerKey.is_null()
+        || !same_guid(&*filter.providerKey, &PROVIDER_KEY)
+        || filter.numFilterConditions as usize != spec.conditions.len()
+        || filter.filterCondition.is_null()
+    {
+        return false;
+    }
+    let conditions =
+        std::slice::from_raw_parts(filter.filterCondition, filter.numFilterConditions as usize);
+    spec.conditions.iter().all(|spec| {
+        conditions.iter().any(|condition| {
+            if condition.matchType != FWP_MATCH_EQUAL {
+                return false;
+            }
+            match spec {
+                ConditionSpec::User => {
+                    if !same_guid(&condition.fieldKey, &FWPM_CONDITION_ALE_USER_ID)
+                        || condition.conditionValue.r#type != FWP_SECURITY_DESCRIPTOR_TYPE
+                    {
+                        return false;
+                    }
+                    let pointer = condition.conditionValue.Anonymous.sd;
+                    if pointer.is_null() {
+                        return false;
+                    }
+                    let actual = &*pointer;
+                    !actual.data.is_null()
+                        && actual.size == user.blob.size
+                        && std::slice::from_raw_parts(actual.data, actual.size as usize)
+                            == std::slice::from_raw_parts(user.blob.data, user.blob.size as usize)
+                }
+                ConditionSpec::Protocol(protocol) => {
+                    same_guid(&condition.fieldKey, &FWPM_CONDITION_IP_PROTOCOL)
+                        && condition.conditionValue.r#type == FWP_UINT8
+                        && condition.conditionValue.Anonymous.uint8 == *protocol
+                }
+                ConditionSpec::RemotePort(port) => {
+                    same_guid(&condition.fieldKey, &FWPM_CONDITION_IP_REMOTE_PORT)
+                        && condition.conditionValue.r#type == FWP_UINT16
+                        && condition.conditionValue.Anonymous.uint16 == *port
+                }
+            }
+        })
+    })
+}
+
+fn same_guid(left: &GUID, right: &GUID) -> bool {
+    left.data1 == right.data1
+        && left.data2 == right.data2
+        && left.data3 == right.data3
+        && left.data4 == right.data4
+}
