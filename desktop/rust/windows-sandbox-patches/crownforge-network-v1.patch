+/// Reads every owned filter without provisioning, refreshing ACLs or changing policy.
+/// Missing, disabled, altered, or inaccessible policy is never treated as ready.
+pub fn verify_wfp_filters_for_account(account: &str) -> Result<()> {
+    anyhow::ensure!(
+        account.eq_ignore_ascii_case(crate::setup::OFFLINE_USERNAME),
+        "CrownForge policy principal mismatch"
+    );
