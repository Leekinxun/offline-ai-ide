{
  "name": "crownforge-desktop",
  "productName": "CrownForge",
  "description": "CrownForge remote desktop client for the shared server workbench",
  "version": "1.1.1",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test *.test.cjs ../scripts/remote-desktop-package.test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package:mac-arm64": "node scripts/package.mjs mac-arm64",
    "package:mac-x64": "node scripts/package.mjs mac-x64",
    "package:win-x64": "node scripts/package.mjs win-x64",
    "package:win7-x64": "node scripts/package.mjs win7-x64",
    "package:win-x64-cross": "node scripts/package-cross-windows.mjs win-x64",
    "package:win7-x64-cross": "node scripts/package-cross-windows.mjs win7-x64"
  },
  "devDependencies": {
    "@electron/rebuild": "3.7.2",
    "electron": "44.4.4",
    "electron-builder": "26.16.1"
  }
}
