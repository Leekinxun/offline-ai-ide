      "expected": "http://127.0.0.1:4312/fixture"
    },
    {
      "id": "loopback-localhost-fixture",
      "input": "http://localhost:4312/fixture",
      "allowLoopbackHttp": true,
      "expected": "http://localhost:4312/fixture"
