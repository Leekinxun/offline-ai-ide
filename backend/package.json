{
  "name": "ai-ide-backend",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test src/agent/*.test.ts src/auth/*.test.ts src/chat/*.test.ts src/debug/*.test.ts src/diagnostics/*.test.ts src/files/*.test.ts src/indexing/*.test.ts src/persistence/*.test.ts src/plugins/*.test.ts src/run/*.test.ts src/security/*.test.ts src/team/*.test.ts",
    "benchmark": "tsx src/agent/benchmark.ts",
    "eval:retrieval": "tsx src/indexing/retrievalEvaluation.ts --assert",
    "benchmark:retrieval": "tsx src/indexing/retrievalBenchmark.ts --profile smoke --assert",
    "benchmark:retrieval:reference": "tsx src/indexing/retrievalBenchmark.ts --profile reference --assert",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "multer": "^2.2.0",
    "node-pty": "^1.0.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  }
}
